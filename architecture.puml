@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Developer / User", "Запрашивает генерацию Lua-кода")
System_Boundary(c1, "Local AI Agent System") {
    Container(api, "Agent API (FastAPI)", "Python", "Предоставляет REST API /generate")
    Container(langgraph, "State Machine Agent", "LangGraph", "Маршрутизирует: Анализ -> RAG -> Генерация -> Валидация")
    Container(lua_compiler, "Local Lua Compiler", "luac 5.4", "Проверяет синтаксис (luac -p) без выполнения кода")
    ContainerDb(templates, "Knowledge Base", "Filesystem", "Хранит .lua шаблоны")
    Container(ollama, "LLM Server (Ollama)", "C++/Go", "Хостит qwen2.5-coder:7b. Лимит 8GB VRAM.")
}

Rel(user, api, "POST /generate", "JSON")
Rel(api, langgraph, "Инициирует граф")
Rel(langgraph, templates, "Читает шаблоны (RAG)")
Rel(langgraph, ollama, "Промпты", "REST")
Rel(langgraph, lua_compiler, "Передает сгенерированный код на проверку")
Rel(lua_compiler, langgraph, "Возвращает Syntax Errors или OK")
@enduml